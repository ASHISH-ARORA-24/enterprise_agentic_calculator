# Environment variable template.
# Copy this file to .env and fill in your own values.
# Never commit .env — it is in .gitignore for this reason.
# Never put real values in this file.

# ---------------------------------------------------------------------------
# Calculator Service
# ---------------------------------------------------------------------------

# Port the calculator service listens on
CALCULATOR_PORT=

# Fault injection mode: none | unhealthy | slow | calculate_500
# Only active in non-production environments
CALCULATOR_FAULT_MODE=

# Log level: DEBUG | INFO | WARNING | ERROR
CALCULATOR_LOG_LEVEL=

# ---------------------------------------------------------------------------
# Agent API
# ---------------------------------------------------------------------------

# Port the agent API listens on
AGENT_API_PORT=

# Full URL of the calculator service (used before MCP is introduced)
CALCULATOR_SERVICE_URL=

# LLM model name (e.g. gpt-4o, claude-sonnet-4-6)
LLM_MODEL_NAME=

# LLM API key — move to Key Vault in Iteration 5
LLM_API_KEY=

# Log level: DEBUG | INFO | WARNING | ERROR
AGENT_API_LOG_LEVEL=

# ---------------------------------------------------------------------------
# MCP Server (added in Iteration 6)
# ---------------------------------------------------------------------------

MCP_SERVER_PORT=

# ---------------------------------------------------------------------------
# PostgreSQL (added in Iteration 8)
# ---------------------------------------------------------------------------

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Azure Service Bus (added in Iteration 10)
# ---------------------------------------------------------------------------

SERVICE_BUS_NAMESPACE=
SERVICE_BUS_QUEUE_NAME=

# ---------------------------------------------------------------------------
# Azure — general (added in Iteration 3)
# ---------------------------------------------------------------------------

AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ---------------------------------------------------------------------------
# Entra ID (added in Iteration 4)
# ---------------------------------------------------------------------------

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
